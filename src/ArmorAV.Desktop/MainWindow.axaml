<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ArmorAV.Desktop.MainWindow"
        Title="ArmorAV"
        Width="1320" Height="840"
        MinWidth="1040" MinHeight="680"
        Background="#0A1020"
        FontFamily="Inter, Segoe UI, Arial">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="15,10" />
      <Setter Property="Background" Value="#1B2A43" />
      <Setter Property="Foreground" Value="#E8EFFA" />
      <Setter Property="BorderBrush" Value="#2A3C5A" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#243958" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2D74DA" />
      <Setter Property="BorderBrush" Value="#4C95F8" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#3D84EB" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#A7B8D2" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#172640" />
      <Setter Property="Foreground" Value="#F1F6FF" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#193B68" />
      <Setter Property="BorderBrush" Value="#285D9F" />
      <Setter Property="Foreground" Value="#F4F8FF" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#101B2D" />
      <Setter Property="BorderBrush" Value="#2A3C5A" />
      <Setter Property="Foreground" Value="#F5F8FE" />
      <Setter Property="Padding" Value="13,11" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="238,*">
    <Border Background="#0D1728" BorderBrush="#1D2C44" BorderThickness="0,0,1,0">
      <Grid Margin="18,22" RowDefinitions="Auto,*,Auto">
        <StackPanel>
          <Grid ColumnDefinitions="42,*">
            <Border Width="38" Height="38" CornerRadius="11" Background="#2C72D4">
              <TextBlock Text="A" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,1,0,0">
              <TextBlock Text="ArmorAV" FontSize="19" FontWeight="Bold" Foreground="#F5F8FE" />
              <TextBlock Text="LOCAL SECURITY" FontSize="9" FontWeight="SemiBold" Foreground="#6F8CB8" />
            </StackPanel>
          </Grid>
          <Border Background="#10233B" BorderBrush="#1D3F67" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,26,0,14">
            <StackPanel Orientation="Horizontal">
              <Border Width="8" Height="8" Background="#49D17D" CornerRadius="4" VerticalAlignment="Center" />
              <TextBlock Text="  Защита активна" Foreground="#B9F0CE" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <TextBlock Text="НАВИГАЦИЯ" FontSize="10" FontWeight="SemiBold" Foreground="#637795" Margin="12,0,0,8" />
          <Button Name="DashboardButton" Classes="nav active" Click="Dashboard_Click">Обзор</Button>
          <Button Name="ScanButtonNav" Classes="nav" Click="ScanPage_Click">Проверка</Button>
          <Button Name="QuarantineButton" Classes="nav" Click="Quarantine_Click">Карантин</Button>
          <Button Name="ReportsButton" Classes="nav" Click="Reports_Click">Отчёты</Button>
        </StackPanel>

        <Border Grid.Row="2" Background="#101C30" CornerRadius="9" Padding="12">
          <StackPanel Spacing="5">
            <TextBlock Text="ArmorAV 4.0" FontWeight="SemiBold" Foreground="#D9E6FA" FontSize="12" />
            <TextBlock Text="Статический анализ без отправки файлов в сеть" TextWrapping="Wrap" Foreground="#7790B4" FontSize="11" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Border Background="#0D1728" BorderBrush="#1D2C44" BorderThickness="0,0,0,1" Padding="32,19">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Name="PageTitleText" Text="Панель безопасности" FontSize="22" FontWeight="Bold" Foreground="#F6F9FF" />
            <TextBlock Name="PageSubtitleText" Text="Контроль локальных проверок и результатов анализа" Foreground="#8FA4C5" FontSize="12" Margin="0,3,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#13253D" CornerRadius="16" Padding="11,6" Margin="0,0,12,0">
              <TextBlock Name="HeaderStatusText" Text="Готов к проверке" Foreground="#BBD4F8" FontSize="12" />
            </Border>
            <Button Classes="primary" Click="StartFromHeader_Click">Новая проверка</Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <ScrollViewer Name="DashboardPanel" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32,28,32,32" Spacing="18">
            <Border Background="#10213A" BorderBrush="#23446F" BorderThickness="1" CornerRadius="14" Padding="24">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                  <TextBlock Text="Состояние системы" FontSize="14" FontWeight="SemiBold" Foreground="#8FB5ED" />
                  <TextBlock Name="DashboardStateText" Text="Готово к безопасной локальной проверке" FontSize="25" FontWeight="Bold" Foreground="#F5F9FF" />
                  <TextBlock Text="ArmorAV анализирует файлы, архивы, скрипты и документы локально. Перед карантином подтверждённые угрозы проверяются повторно." Foreground="#A4B7D2" TextWrapping="Wrap" MaxWidth="690" />
                  <Button Classes="primary" Click="StartFromHeader_Click" HorizontalAlignment="Left" Margin="0,9,0,0">Начать проверку</Button>
                </StackPanel>
                <Border Grid.Column="1" Width="104" Height="104" CornerRadius="52" Background="#163E69" BorderBrush="#2E78C9" BorderThickness="2" VerticalAlignment="Center">
                  <TextBlock Text="✓" FontSize="47" FontWeight="Bold" Foreground="#81D7FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*">
              <Border Background="#101A2B" BorderBrush="#1E304A" BorderThickness="1" CornerRadius="11" Padding="18" Margin="0,0,10,0">
                <StackPanel Spacing="6"><TextBlock Text="СТАТУС" Foreground="#6F85A8" FontSize="10" FontWeight="Bold" /><TextBlock Name="StatusMetricText" Text="Готов" FontSize="21" FontWeight="SemiBold" Foreground="#F5F9FF" /><TextBlock Text="движок доступен" Foreground="#8195B4" FontSize="11" /></StackPanel>
              </Border>
              <Border Grid.Column="1" Background="#101A2B" BorderBrush="#1E304A" BorderThickness="1" CornerRadius="11" Padding="18" Margin="0,0,10,0">
                <StackPanel Spacing="6"><TextBlock Text="ПРОВЕРЕНО" Foreground="#6F85A8" FontSize="10" FontWeight="Bold" /><TextBlock Name="ScannedMetricText" Text="—" FontSize="21" FontWeight="SemiBold" Foreground="#F5F9FF" /><TextBlock Text="файлов за сеанс" Foreground="#8195B4" FontSize="11" /></StackPanel>
              </Border>
              <Border Grid.Column="2" Background="#101A2B" BorderBrush="#1E304A" BorderThickness="1" CornerRadius="11" Padding="18" Margin="0,0,10,0">
                <StackPanel Spacing="6"><TextBlock Text="УГРОЗЫ" Foreground="#6F85A8" FontSize="10" FontWeight="Bold" /><TextBlock Name="ThreatMetricText" Text="—" FontSize="21" FontWeight="SemiBold" Foreground="#F5F9FF" /><TextBlock Text="подтверждено" Foreground="#8195B4" FontSize="11" /></StackPanel>
              </Border>
              <Border Grid.Column="3" Background="#101A2B" BorderBrush="#1E304A" BorderThickness="1" CornerRadius="11" Padding="18">
                <StackPanel Spacing="6"><TextBlock Text="ПОСЛЕДНИЙ СЕАНС" Foreground="#6F85A8" FontSize="10" FontWeight="Bold" /><TextBlock Name="DurationMetricText" Text="—" FontSize="21" FontWeight="SemiBold" Foreground="#F5F9FF" /><TextBlock Text="время анализа" Foreground="#8195B4" FontSize="11" /></StackPanel>
              </Border>
            </Grid>

            <Border Background="#101A2B" BorderBrush="#1E304A" BorderThickness="1" CornerRadius="11" Padding="18">
              <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                  <StackPanel><TextBlock Text="Последние результаты" FontSize="16" FontWeight="SemiBold" Foreground="#F2F6FE" /><TextBlock Text="Здесь появятся результаты завершённой проверки." Foreground="#8195B4" FontSize="12" Margin="0,3,0,0" /></StackPanel>
                  <Button Grid.Column="1" Click="ScanPage_Click">Открыть проверку</Button>
                </Grid>
                <ListBox Name="DashboardResultsList" Grid.Row="1" Background="Transparent" BorderThickness="0" MaxHeight="245">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#152238" CornerRadius="7" Padding="12" Margin="0,3">
                        <Grid ColumnDefinitions="95,*,Auto"><TextBlock Text="{Binding Verdict}" FontWeight="Bold" Foreground="#B9D7FF" /><TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="#E7EFFC" /><TextBlock Grid.Column="2" Text="{Binding ScoreText}" Foreground="#91A8C9" /></Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Name="ScanPanel" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <Grid Margin="32,28,32,32" ColumnDefinitions="*,304">
            <StackPanel Spacing="18">
              <Border Background="#101A2B" BorderBrush="#1E304A" BorderThickness="1" CornerRadius="12" Padding="22">
                <StackPanel Spacing="12">
                  <TextBlock Text="Выберите объект для проверки" FontSize="19" FontWeight="SemiBold" Foreground="#F4F8FF" />
                  <TextBlock Text="Файлы не покидают компьютер. Для каталогов ArmorAV проходит вложенные папки в пределах заданных лимитов." Foreground="#93A8C8" TextWrapping="Wrap" />
                  <TextBox Name="TargetPathBox" Watermark="Путь к файлу или папке" FontSize="14" />
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Button Click="BrowseFile_Click">Выбрать файл</Button>
                    <Button Click="BrowseFolder_Click" Margin="10,0,0,0">Выбрать папку</Button>
                    <Button Name="RunScanButton" Classes="primary" Click="Scan_Click" Margin="10,0,0,0">Запустить анализ</Button>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Background="#101A2B" BorderBrush="#1E304A" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid RowDefinitions="Auto,Auto,*">
                  <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Name="ScanSummaryText" Text="Результаты проверки" FontSize="18" FontWeight="SemiBold" Foreground="#F2F6FE" /><TextBlock Name="ScanMetricsText" Text="После анализа здесь появится сводка." Foreground="#879DBF" FontSize="12" Margin="0,4,0,0" /></StackPanel><ProgressBar Name="ScanProgress" Grid.Column="1" Width="150" Height="7" IsIndeterminate="False" VerticalAlignment="Center" /></Grid>
                  <Grid Grid.Row="1" Margin="0,21,0,7" ColumnDefinitions="105,70,110,*"><TextBlock Text="ВЕРДИКТ" Foreground="#6E84A6" FontSize="10" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="БАЛЛ" Foreground="#6E84A6" FontSize="10" FontWeight="Bold" /><TextBlock Grid.Column="2" Text="ТИП" Foreground="#6E84A6" FontSize="10" FontWeight="Bold" /><TextBlock Grid.Column="3" Text="ФАЙЛ" Foreground="#6E84A6" FontSize="10" FontWeight="Bold" /></Grid>
                  <ListBox Name="ScanResultsList" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="ScanResults_SelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#152238" CornerRadius="7" Padding="12" Margin="0,3">
                          <Grid ColumnDefinitions="105,70,110,*"><TextBlock Text="{Binding Verdict}" FontWeight="Bold" Foreground="#B9D7FF" /><TextBlock Grid.Column="1" Text="{Binding ScoreText}" Foreground="#D5E1F2" /><TextBlock Grid.Column="2" Text="{Binding FileType}" Foreground="#93A9C9" /><TextBlock Grid.Column="3" Text="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="#EEF4FF" /></Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="18">
              <Border Background="#101A2B" BorderBrush="#1E304A" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel Spacing="14"><TextBlock Text="Параметры анализа" FontSize="16" FontWeight="SemiBold" Foreground="#F1F6FE" /><CheckBox Name="CacheCheckBox" IsChecked="True" Content="Использовать локальный кэш" /><CheckBox Name="QuarantineCheckBox" Content="Карантинировать Confirmed" /><TextBlock Text="Карантин отключён по умолчанию. Он затрагивает только подтверждённые угрозы." Foreground="#7F95B7" FontSize="11" TextWrapping="Wrap" /></StackPanel>
              </Border>
              <Border Background="#101A2B" BorderBrush="#1E304A" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel Spacing="8"><TextBlock Text="Детали выбранного файла" FontSize="16" FontWeight="SemiBold" Foreground="#F1F6FE" /><TextBlock Name="ResultDetailsText" Text="Выберите строку в результатах, чтобы увидеть срабатывания." TextWrapping="Wrap" Foreground="#92A7C5" FontSize="12" /></StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <ScrollViewer Name="QuarantinePanel" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32,28,32,32" Spacing="18">
            <Border Background="#101A2B" BorderBrush="#1E304A" BorderThickness="1" CornerRadius="12" Padding="22">
              <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Локальный карантин" FontSize="20" FontWeight="SemiBold" Foreground="#F4F8FF" /><TextBlock Text="Здесь находятся только файлы, помещённые в карантин по вашему явному выбору. Восстановление не перезаписывает существующий файл." Foreground="#93A8C8" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel><Button Grid.Column="1" Click="RefreshQuarantine_Click">Обновить</Button></Grid>
            </Border>
            <Border Background="#101A2B" BorderBrush="#1E304A" BorderThickness="1" CornerRadius="12" Padding="18">
              <Grid RowDefinitions="*,Auto"><ListBox Name="QuarantineList" Background="Transparent" BorderThickness="0" SelectionChanged="Quarantine_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Background="#152238" CornerRadius="7" Padding="13" Margin="0,3"><StackPanel Spacing="3"><TextBlock Text="{Binding Headline}" FontWeight="SemiBold" Foreground="#EAF1FC" /><TextBlock Text="{Binding Details}" Foreground="#91A7C8" FontSize="12" TextTrimming="CharacterEllipsis" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,0,0"><TextBlock Name="QuarantineInfoText" Text="Выберите объект для восстановления." Foreground="#8EA4C4" VerticalAlignment="Center" TextWrapping="Wrap" /><Button Name="RestoreButton" Grid.Column="1" Classes="primary" Click="Restore_Click" IsEnabled="False">Восстановить</Button></Grid></Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Name="ReportsPanel" IsVisible="False" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="32,28,32,32" Spacing="18">
            <Border Background="#10213A" BorderBrush="#23446F" BorderThickness="1" CornerRadius="12" Padding="24"><StackPanel Spacing="7"><TextBlock Text="Экспорт отчёта" FontSize="21" FontWeight="SemiBold" Foreground="#F4F8FF" /><TextBlock Text="Сохраните результаты последней проверки для анализа, передачи в SOC или подключения к CI-процессу." Foreground="#A4B7D2" TextWrapping="Wrap" /></StackPanel></Border>
            <Grid ColumnDefinitions="*,*">
              <Border Background="#101A2B" BorderBrush="#1E304A" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,9,0"><StackPanel Spacing="10"><TextBlock Text="JSON" FontSize="17" FontWeight="SemiBold" Foreground="#F1F6FE" /><TextBlock Text="Полные машинно-читаемые результаты сканирования." Foreground="#8EA4C4" TextWrapping="Wrap" /><Button Name="ExportJsonButton" Click="ExportJson_Click" IsEnabled="False" HorizontalAlignment="Left">Сохранить JSON</Button></StackPanel></Border>
              <Border Grid.Column="1" Background="#101A2B" BorderBrush="#1E304A" BorderThickness="1" CornerRadius="12" Padding="20" Margin="9,0,0,0"><StackPanel Spacing="10"><TextBlock Text="HTML" FontSize="17" FontWeight="SemiBold" Foreground="#F1F6FE" /><TextBlock Text="Наглядный отчёт, который можно открыть в браузере." Foreground="#8EA4C4" TextWrapping="Wrap" /><Button Name="ExportHtmlButton" Click="ExportHtml_Click" IsEnabled="False" HorizontalAlignment="Left">Сохранить HTML</Button></StackPanel></Border>
            </Grid>
            <Grid ColumnDefinitions="*,*">
              <Border Background="#101A2B" BorderBrush="#1E304A" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,9,0"><StackPanel Spacing="10"><TextBlock Text="CSV" FontSize="17" FontWeight="SemiBold" Foreground="#F1F6FE" /><TextBlock Text="Компактная таблица для Excel и других систем." Foreground="#8EA4C4" TextWrapping="Wrap" /><Button Name="ExportCsvButton" Click="ExportCsv_Click" IsEnabled="False" HorizontalAlignment="Left">Сохранить CSV</Button></StackPanel></Border>
              <Border Grid.Column="1" Background="#101A2B" BorderBrush="#1E304A" BorderThickness="1" CornerRadius="12" Padding="20" Margin="9,0,0,0"><StackPanel Spacing="10"><TextBlock Text="SARIF 2.1" FontSize="17" FontWeight="SemiBold" Foreground="#F1F6FE" /><TextBlock Text="Формат для CI/CD, security tools и code scanning." Foreground="#8EA4C4" TextWrapping="Wrap" /><Button Name="ExportSarifButton" Click="ExportSarif_Click" IsEnabled="False" HorizontalAlignment="Left">Сохранить SARIF</Button></StackPanel></Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
